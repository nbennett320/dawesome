{
  "name": "@dawsome/ui",
  "version": "0.1.1",
  "private": true,
  "license": "GPL-3.0-or-later",
  "packageManager": "pnpm@8.15.4",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "ui:start": "vite dev --port 4431 --strictPort",
    "ui:build": "vite build",
    "ui:test": "vitest run",
    "engine:test": "cargo test --manifest-path engine/Cargo.toml",
    "engine:test:ignored": "cargo test --manifest-path engine/Cargo.toml -- --ignored --test-threads=1",
    "engine:clean": "cargo clean --manifest-path engine/Cargo.toml -p app",
    "info": "tauri info",
    "build": "tauri build",
    "build:assets:link": "ln -s engine/assets/ engine/target/assets",
    "dev": "tauri dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier -w src/",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "version:bump": "./scripts/bump-version.sh"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.14.0",
    "@tauri-apps/api": "~2.11.1",
    "@tauri-apps/plugin-dialog": "~2.7.3",
    "@tauri-apps/plugin-fs": "~2.5.2",
    "p5": "^1.5.0",
    "react": "18.3.1",
    "react-complex-tree": "^1.1.9",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "18.3.1",
    "react-p5-wrapper": "^3.4.0",
    "react-redux": "^9.3.1",
    "react-resizable-panels": "^4.21.0",
    "react-tabs": "^6.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@tauri-apps/cli": "~2.11.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/p5": "^1.4.3",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "10.6.2",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "^17",
    "jsdom": "^31",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "sass": "1.108.2",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "8.3.8",
    "vitepress": "1.6.4",
    "vitest": "^5.1.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
