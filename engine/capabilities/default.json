{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "what the main window's frontend may call",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "dialog:allow-ask",
    "dialog:allow-open",
    "dialog:allow-save",
    {
      "identifier": "fs:allow-read-dir",
      "allow": [{ "path": "**" }]
    }
  ]
}
